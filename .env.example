# Copie estas variaveis para: Vercel > Project > Settings > Environment Variables
# NUNCA coloque valores reais neste arquivo nem suba certificados para o GitHub.

# ---- Loja ----
STORE_NAME=RobuxStore
PRICE_CENTS_PER_ROBUX=5          # 5 centavos = R$ 0,05 por ROBUX
MIN_QTY=50                       # minimo de ROBUX por compra
INITIAL_STOCK=3400               # estoque inicial (so vale na 1a vez; depois ajuste pelo painel /admin)
HOLD_SECONDS=900                 # tempo que o Pix vale e o estoque fica reservado (15 min)
COUPONS={"PROMO2":2}             # cupons em JSON: codigo -> % de desconto

# ---- Painel do dono ----
ADMIN_PASSWORD=adryellins

# ---- tawk.to (link do widget: https://tawk.to/chat/PROPERTY_ID/WIDGET_ID) ----
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# ---- Banco Inter (API Pix, conta PJ) ----
INTER_CLIENT_ID= 
INTER_CLIENT_SECRET=
INTER_PIX_KEY=                   # a chave Pix da sua conta PJ que recebe os pagamentos
# Certificado da integracao: cole o conteudo em base64 (veja o README)
INTER_CERT_B64=
INTER_KEY_B64=
# Opcional: so se sua conta exigir (varias contas correntes)
INTER_CONTA_CORRENTE=
# Opcional: URL do site (ex.: https://minhaloja.vercel.app) usada ao registrar o webhook
SITE_URL=

# ---- Banco de dados (Upstash Redis) ----
# Criados automaticamente ao conectar o Upstash Redis no Vercel (Storage):
KV_REST_API_URL=
KV_REST_API_TOKEN=
